# Copy names into the shell or a secret store. Do not commit a filled .env.
# The default provider is the local stub. It needs no key and spends nothing.
# CI uses this default. It does not set LIVE_MODE or a model key.

LLM_PROVIDER=fake

# Live mode is optional and off. The only opt-in is the exact value 1.
# "true" does not turn it on. Do not set this in CI.
# LIVE_MODE=1
#
# Hosted providers: xai, openai, anthropic.
# LLM_PROVIDER=xai
#
# Base URL, model, and key come only from the environment. There is no
# default host in code. These official bases are comments, not values:
#   xAI (OpenAI-compatible): https://api.x.ai/v1
#     the client appends /chat/completions
#   OpenAI: https://api.openai.com/v1
#     the client appends /chat/completions
#   Anthropic Messages adapter: https://api.anthropic.com
#     the client appends /v1/messages
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# LLM_TIMEOUT_S=30
# LLM_MAX_OUTPUT_TOKENS=1024
#
# Prices are USD per 1,000,000 tokens. Leave them empty here. Copy the
# numbers from the provider's official pricing page on the day you measure,
# and set LLM_PRICE_DATE to that date (YYYY-MM-DD). This repo does not
# ship a vendor price. If the page moves, start from the provider's docs:
#   xAI: https://docs.x.ai/docs/models
#   OpenAI: https://platform.openai.com/docs/pricing
#   Anthropic: https://platform.claude.com/docs/en/about-claude/pricing
# LLM_PRICE_DATE=
# LLM_INPUT_USD_PER_MILLION=
# LLM_OUTPUT_USD_PER_MILLION=
# Optional. Cached input rate from the same page. If a response reports
# cached tokens and this is empty, those tokens are priced at the full
# input rate and the log says token_table_cached_as_uncached.
# LLM_CACHED_INPUT_USD_PER_MILLION=
# Hard cap in USD for one run and for the whole process. Required when live.
# MAX_LIVE_SPEND_USD=

# Local files. Production would point DATABASE_PATH at Postgres instead
# (see docs/adr/0001-sqlite-now-postgres-skip-locked.md).
DATABASE_PATH=var/runtime.sqlite
TRACE_DIR=var/traces
EVALS_DIR=evals

# Stub-model budget for one run, in micro-USD (1 USD = 1_000_000).
# This caps recorded model spend, not the refund amount. The refund cap is
# in code. Hosted calls also have MAX_LIVE_SPEND_USD, which is separate.
RUN_BUDGET_MICRO_USD=100000
MAX_STEP_ATTEMPTS=3
CIRCUIT_BREAKER_THRESHOLD=3
MAX_AGENT_STEPS=8
RETRY_BACKOFF_MS=0

# Deterministic checker. Trajectory checks block regardless of this threshold.
# This is not an LLM judge.
EVAL_CHECK_THRESHOLD=0.8

LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8080

# Required to run `agent-runtime serve`. Leave it empty in the repo.
# Set a long random value in the environment. GET /health does not use it.
API_TOKEN=
