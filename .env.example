# Copy to the shell or to a secret store. Do not commit a real .env file.
# The default provider is the local stub. It needs no key and spends nothing.

# fake (default) or openai
LLM_PROVIDER=fake

# Required only when LLM_PROVIDER=openai. Leave empty here.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_S=30

# Local files. Production would point DATABASE_PATH at Postgres instead
# (see docs/adr/0001-sqlite-now-postgres-skip-locked.md).
DATABASE_PATH=var/runtime.sqlite
TRACE_DIR=var/traces
EVALS_DIR=evals

# Stub-model budget for one run, in micro-USD (1 USD = 1_000_000).
# This caps model spend, not the refund amount. The refund cap is in code.
RUN_BUDGET_MICRO_USD=100000
MAX_STEP_ATTEMPTS=3
CIRCUIT_BREAKER_THRESHOLD=3
MAX_AGENT_STEPS=8
RETRY_BACKOFF_MS=0

# Deterministic checker. Trajectory checks block regardless of this threshold.
# This is not an LLM judge.
EVAL_CHECK_THRESHOLD=0.8

LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8080

# Required to run `agent-runtime serve`. Leave it empty in the repo.
# Set a long random value in the environment. GET /health does not use it.
API_TOKEN=
